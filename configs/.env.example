# Database Configuration
# PostgreSQL connection string for the inventory forecasting system
# Format: postgresql+psycopg2://username:password@host:port/database
# Note: Use a read-only database user for production deployments
PG_URI=postgresql+psycopg2://username:password@localhost:5432/inventory_db

# Model Training Parameters (Optional)
# Minimum number of data points required for training
MIN_TRAIN_PERIODS=56

# Default seasonality for daily data (7 = weekly pattern)
DEFAULT_SEASON=7

# API Configuration (Optional)
# FastAPI server host and port
API_HOST=0.0.0.0
API_PORT=8000

# Debug mode (set to 'true' for development)
DEBUG=false

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Performance Tuning (Optional)
# Maximum number of database connections in pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Cache settings for forecast results (in seconds)
FORECAST_CACHE_TTL=300

# Model Training Settings
# Maximum number of series to process in batch training
MAX_SERIES_BATCH=1000

# Backtest configuration (number of weeks for validation)
BACKTEST_WEEKS=12

# Security (Production Only)
# JWT secret key for API authentication (generate a secure random string)
# JWT_SECRET=your-secret-key-here

# CORS settings (comma-separated list of allowed origins)
# ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# Instructions:
# 1. Copy this file to .env in the project root
# 2. Update the PG_URI with your actual database credentials
# 3. Adjust other settings based on your deployment environment
# 4. Ensure the database user has appropriate read permissions on:
#    - brand_x_data table
#    - brand_x_gold materialized view  
#    - demand_daily materialized view
# 5. Never commit the actual .env file to version control
